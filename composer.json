{
    "name": "blueroger/cms-extensions",
    "description": "Extended CMS blocks with flexible column widths and configurable CSS classes for shopping experiences.",
    "version": "2.0.0",
    "type": "shopware-platform-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Blueroger",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "shopware/core": "~6.7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "shopwarelabs/phpstan-shopware": "^0.1"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": ["@analyse", "@cs-check"]
    },
    "extra": {
        "shopware-plugin-class": "Blueroger\\CmsExtensions\\BluerogerCmsExtensions",
        "label": {
            "de-DE": "Blueroger - Erweiterte Inhaltselemente",
            "en-GB": "Blueroger - Extended Content Elements"
        },
        "description": {
            "de-DE": "Erweiterte CMS-Blöcke mit konfigurierbaren Spaltenbreiten und CSS-Klassen für Shopware-6-Shopping-Experiences. Ideal für flexible Layouts und mehrspaltige Inhalte im Storefront.",
            "en-GB": "Extended CMS blocks with flexible column widths and configurable CSS classes for Shopware 6 Shopping Experiences. Ideal for flexible storefront layouts and multi-column content."
        },
        "manufacturerLink": {
            "de-DE": "https://github.com/blueroger",
            "en-GB": "https://github.com/blueroger"
        },
        "supportLink": {
            "de-DE": "https://github.com/blueroger/BluerogerCmsExtensions/issues",
            "en-GB": "https://github.com/blueroger/BluerogerCmsExtensions/issues"
        }
    },
    "autoload": {
        "psr-4": {
            "Blueroger\\CmsExtensions\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
