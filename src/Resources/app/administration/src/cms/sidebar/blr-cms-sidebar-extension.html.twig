{# TODO 6.7: sw_cms_sidebar_layout_assignment — Block-Name nach Migration prüfen #}
{% block sw_cms_sidebar_layout_assignment %}
    {% parent %}
    <sw-sidebar-item
        icon="regular-line-column"
        :title="'Blueroger: Block-Einstellungen'"
    >
        <sw-sidebar-collapse
            v-if="selectedBlock && (selectedBlock.type === 'blr-two-col-flex' || selectedBlock.type === 'blr-three-col-flex')"
            :expand-on-loading="true"
        >
            <template #header>
                <span>{{
                    selectedBlock.type === 'blr-two-col-flex'
                        ? $tc('blr.cms.blocks.twoColFlex.label')
                        : $tc('blr.cms.blocks.threeColFlex.label')
                }}</span>
            </template>
            <template #content>
                <component
                    v-if="selectedBlock.type === 'blr-two-col-flex'"
                    :is="'cms-block-blr-two-col-flex-config'"
                    :block="selectedBlock"
                    @block-update="onBlockUpdate"
                />
                <component
                    v-else-if="selectedBlock.type === 'blr-three-col-flex'"
                    :is="'cms-block-blr-three-col-flex-config'"
                    :block="selectedBlock"
                    @block-update="onBlockUpdate"
                />
            </template>
        </sw-sidebar-collapse>
    </sw-sidebar-item>
{% endblock %}
