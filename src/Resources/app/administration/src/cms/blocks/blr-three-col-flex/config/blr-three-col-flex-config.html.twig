<mt-card
    class="cms-block-blr-three-col-flex-config"
>
    <mt-select
        v-model="block.customFields.columnRatio"
        :options="columnRatioOptions"
        :label="$t('blr.cms.blocks.threeColFlex.config.columnRatio.label')"
        :small="true"
        :hide-clearable-button="true"
    />

    <mt-select
        v-model="block.customFields.responsiveBreakpoint"
        :options="breakpointOptions"
        :label="$t('blr.cms.blocks.threeColFlex.config.responsiveBreakpoint.label')"
        :small="true"
        :hide-clearable-button="true"
    />

    <mt-text-field
        v-model="block.customFields.cssClassLeft"
        :label="$t('blr.cms.blocks.threeColFlex.config.cssClassLeft.label')"
    />

    <mt-text-field
        v-model="block.customFields.cssClassCenter"
        :label="$t('blr.cms.blocks.threeColFlex.config.cssClassCenter.label')"
    />

    <mt-text-field
        v-model="block.customFields.cssClassRight"
        :label="$t('blr.cms.blocks.threeColFlex.config.cssClassRight.label')"
    />
</mt-card>